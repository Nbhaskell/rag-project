# Optional settings for `docker compose up`. Copy this file to .env and change what you need.
# Nothing here is required: without a .env file everything below has the default shown.

# Where Ollama is. The default reaches Ollama running on the machine that runs Docker.
# (On Linux that Ollama must listen on more than 127.0.0.1: start it with OLLAMA_HOST=0.0.0.0.)
#OLLAMA_HOST=http://host.docker.internal:11434

# Which folder of documents to answer from (default: the made-up demo documents in demo_docs).
#DOCS_PATH=./demo_docs

# The address and port the chat is published on. 127.0.0.1 means this computer only.
#BIND_ADDRESS=127.0.0.1
#HOST_PORT=8000

# Settings the program itself reads (see guides/public-server.md):
#RAG_RATE_PER_MIN=30
#RAG_DAILY_LIMIT=0
#RAG_MAX_CONCURRENT=2
#RAG_ALLOW_REINDEX=1
#RAG_WATCH=1
#RAG_MODEL_TIMEOUT=180
#RAG_LOG_QUESTIONS=1
#RAG_API_TOKEN=
